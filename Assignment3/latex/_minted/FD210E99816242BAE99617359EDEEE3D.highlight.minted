\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k}{def} \PYG{n+nf}{otsuManyClasses}\PYG{p}{(}\PYG{n}{image}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{imageNP} \PYG{o}{=} \PYG{n}{ConverTKINTERtoCV2}\PYG{p}{(}\PYG{n}{image}\PYG{p}{)}
    \PYG{c+c1}{\PYGZsh{}make image gray}
    \PYG{n}{gray} \PYG{o}{=} \PYG{n}{cv2}\PYG{o}{.}\PYG{n}{cvtColor}\PYG{p}{(}\PYG{n}{imageNP}\PYG{p}{,} \PYG{n}{cv2}\PYG{o}{.}\PYG{n}{COLOR\PYGZus{}BGR2GRAY}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}we can change the class count here}
    \PYG{n}{classes} \PYG{o}{=} \PYG{n+nb}{int}\PYG{p}{(}\PYG{n}{classCombo}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{p}{)}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}qpply Multi\PYGZhy{}Otsu Thresholding}
    \PYG{n}{thresholds} \PYG{o}{=} \PYG{n}{threshold\PYGZus{}multiotsu}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n}{classes}\PYG{o}{=}\PYG{n}{classes}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}assign labels to different regions}
    \PYG{n}{regions} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{digitize}\PYG{p}{(}\PYG{n}{gray}\PYG{p}{,} \PYG{n}{bins}\PYG{o}{=}\PYG{n}{thresholds}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}convert regions fomr 64 bit to 8 bit for tkinter}
    \PYG{n}{regions} \PYG{o}{=} \PYG{n}{util}\PYG{o}{.}\PYG{n}{img\PYGZus{}as\PYGZus{}ubyte}\PYG{p}{(}\PYG{n}{regions}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}generate a colormap based on matplots preset tab10 colorset, so the colors are always distincly different}
    \PYG{c+c1}{\PYGZsh{}than normalize those color values to scale to grey scale}
    \PYG{n}{colormap} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{p}{[}\PYG{n}{plt}\PYG{o}{.}\PYG{n}{cm}\PYG{o}{.}\PYG{n}{get\PYGZus{}cmap}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}}\PYG{l+s+s2}{tab10}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}\PYG{p}{(}\PYG{n}{i}\PYG{p}{)}\PYG{p}{[}\PYG{p}{:}\PYG{l+m+mi}{3}\PYG{p}{]} \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{classes}\PYG{p}{)}\PYG{p}{]}\PYG{p}{)} \PYG{o}{*} \PYG{l+m+mi}{255}

    \PYG{c+c1}{\PYGZsh{}empty image to cast colors to}
    \PYG{n}{color} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{zeros}\PYG{p}{(}\PYG{p}{(}\PYG{o}{*}\PYG{n}{gray}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{,} \PYG{l+m+mi}{3}\PYG{p}{)}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{np}\PYG{o}{.}\PYG{n}{uint8}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}apply colors to each of the regions in the range}
    \PYG{k}{for} \PYG{n}{i} \PYG{o+ow}{in} \PYG{n+nb}{range}\PYG{p}{(}\PYG{n}{classes}\PYG{p}{)}\PYG{p}{:}
        \PYG{n}{color}\PYG{p}{[}\PYG{n}{regions} \PYG{o}{==} \PYG{n}{i}\PYG{p}{]} \PYG{o}{=} \PYG{n}{colormap}\PYG{p}{[}\PYG{n}{i}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{}convert back to Tkinter format}
    \PYG{n}{filteredImage} \PYG{o}{=} \PYG{n}{ConvertCV2ToTKINTER}\PYG{p}{(}\PYG{n}{color}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}update the Tkinter image label}
    \PYG{n}{imageBottom}\PYG{o}{.}\PYG{n}{config}\PYG{p}{(}\PYG{n}{image}\PYG{o}{=}\PYG{n}{filteredImage}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{}keep image reference}
    \PYG{n}{imageBottom}\PYG{o}{.}\PYG{n}{image} \PYG{o}{=} \PYG{n}{filteredImage}

    \PYG{k}{return}
\end{MintedVerbatim}
